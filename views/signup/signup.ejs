<!--
    Sign Up Page
    This page is rendered server-side and does not use the SPA framework. It provides a form for users to create a new account. The form includes fields for name, email, password, and password confirmation. It also handles error messages and redirects after successful sign-up.
    The page uses a simple CSS layout to center the form and style the input fields and buttons.
-->
<!DOCTYPE html>
<html lang="en">

<!-- Sign Up Page Head -->
<head>
    <meta charset="UTF-8">
    <title>Sathvik Vemulapalli: Sign Up</title>
    <link rel="stylesheet" href="/style.css">

    <!-- Sign Up Page Styles -->
    <style>
        body, html {
            height: 100%; width: 100%; margin: 0;
            display: flex; justify-content: center; align-items: center;
        }
        .signup-box {
            background: var(--form-bg-color);
            border: 1px solid var(--form-border-color);
            border-radius: 12px;
            padding: 40px 48px;
            min-width: 320px;
            max-width: 400px;
            width: 100%;
        }
        .signup-box h2 { margin-bottom: 24px; }
        .signup-box input { width: 100%; box-sizing: border-box; margin-bottom: 14px; display: block; }
        .signup-box button[type="submit"] { width: 100%; margin-top: 4px; }
        .error { color: #e74c3c; font-size: 13px; margin-bottom: 10px; text-align: center; }
        .switch-link { text-align: center; font-size: 13px; margin-top: 16px; }
    </style>
</head>

<!-- Sign Up Page Body -->
<body>
    <!-- Sign Up Form -->
    <div class="signup-box">
        <h2>Sign Up</h2>
        <!-- Display error message if present -->
        <% if (error) { %><div class="error"><%- error %></div><% } %>

        <!-- Display app name if present -->
        <% if (appName) { %><div style="text-align:center;font-size:13px;margin-bottom:10px;opacity:0.6;">Sign up to continue to <strong><%- appName %></strong></div><% } %>

        <!-- Sign Up Form Fields -->
        <form method="POST" action="/signup">
            <input type="hidden" name="redirect" value="<%= redirect %>">
            <input type="hidden" name="app" value="<%= appName %>">
            <input type="text" name="name" placeholder="Name" autocomplete="name" required>
            <input type="email" name="email" placeholder="Email" autocomplete="email" required>
            <input type="password" name="pass" placeholder="Password (min 8 chars)" autocomplete="new-password" required>
            <input type="password" name="pass2" placeholder="Confirm Password" autocomplete="new-password" required>
            <button type="submit">Create Account</button>
        </form>

        <!-- Links to switch to login or back to site -->
        <div class="switch-link"><a href="/login<%= redirect ? `?redirect=${encodeURIComponent(redirect)}&app=${encodeURIComponent(appName)}` : `` %>">Already have an account? Log in</a></div>
        <div class="switch-link"><a href="/">← Back to site</a></div>
    </div>

